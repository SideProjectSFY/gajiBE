# Gaji Backend - Environment Variables Template
# Copy this file to .env and fill in your values

# Database Configuration (Story 0.3)
DB_URL=jdbc:postgresql://localhost:5432/gaji_dev
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# AI/RAG Configuration
GEMINI_API_KEY=your_gemini_api_key_here
ELASTICSEARCH_URL=http://localhost:9200
RAG_ELASTICSEARCH_ENABLED=true
RAG_ELASTICSEARCH_INDEX=gaji_novel_passages_v1

# JWT Configuration (Epic 6)
JWT_SECRET=your-secure-secret-key-at-least-32-characters-long

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
